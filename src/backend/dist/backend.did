type WalletActivityType = 
 variant {
   auctionPayout;
   deposit;
   mintCost;
 };
type WalletActivity = 
 record {
   activityType: WalletActivityType;
   btcAmountE8s: nat;
   description: text;
   status: variant {
             confirmed;
             pending;
           };
   timestamp: int;
 };
type VideoClipSort = 
 variant {
   newest;
   top;
   trending;
 };
type VideoClip = 
 record {
   clip_id: text;
   creator_principal_id: principal;
   explicit_flag: bool;
   hashtags: vec text;
   like_count: nat;
   like_timestamps: vec record {
                          principal;
                          int;
                        };
   likes_last_24_hours: nat;
   likes_last_6_hours: nat;
   likes_last_hour: nat;
   preview_loop_url: text;
   timestamp: int;
   title: opt text;
   video_file_url: text;
 };
type VideoAsset = 
 record {
   asset_id: text;
   content_type: text;
   created_at: int;
   data: blob;
   owner: principal;
 };
type UserWallet = 
 record {
   btcAddress: text;
   btcBalanceE8s: nat;
   deposits: vec Deposit;
   payouts: vec Payout;
   usdValueRef: float64;
   walletPrincipalId: principal;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = record {name: text;};
type UpdateTcgSetInput = 
 record {
   cardCount: opt nat;
   coverImageUrl: text;
   featured: bool;
   id: nat;
   isActive: bool;
   releaseYear: nat;
   setCode: text;
   setName: text;
   slug: text;
   sortOrder: nat;
   tcgCategory: text;
 };
type UpdateTcgCategoryInput = 
 record {
   id: nat;
   imageUrl: text;
   isActive: bool;
   name: text;
   slug: text;
   sortOrder: nat;
 };
type UpdateTcgCardInput = 
 record {
   cardName: text;
   cardNumber: text;
   id: nat;
   imageUrl: text;
   isActive: bool;
   isSupported: bool;
   rarity: text;
   setId: nat;
   sortOrder: nat;
 };
type TxType = 
 variant {
   copySale;
   mintFee;
   secondaryTrade;
 };
type TxSplit = 
 record {
   btcAddress: text;
   btcAmountSimulated: float64;
   "principal": principal;
   role: text;
   usdAmount: float64;
 };
type Transaction = 
 record {
   clipId: text;
   id: nat;
   splits: vec TxSplit;
   status: text;
   timestamp: int;
   totalUsd: float64;
   txType: TxType;
 };
type Track = 
 record {
   duration: nat;
   title: text;
 };
type TcgSet = 
 record {
   cardCount: opt nat;
   coverImageUrl: text;
   featured: bool;
   id: nat;
   isActive: bool;
   releaseYear: nat;
   setCode: text;
   setName: text;
   slug: text;
   sortOrder: nat;
   tcgCategory: text;
 };
type TcgCategory = 
 record {
   id: nat;
   imageUrl: text;
   isActive: bool;
   name: text;
   slug: text;
   sortOrder: nat;
 };
type TcgCard = 
 record {
   cardName: text;
   cardNumber: text;
   id: nat;
   imageUrl: text;
   isActive: bool;
   isSupported: bool;
   rarity: text;
   setId: nat;
   sortOrder: nat;
 };
type Release = 
 record {
   album: Album;
   floorPrice: nat;
   isActive: bool;
   lastSoldPrice: nat;
   mintOpenTime: int;
   mintedCount: nat;
   ownersCount: nat;
 };
type PurchaseStatus = 
 variant {
   minted;
   pending;
 };
type PurchaseRecord = 
 record {
   buyerPrincipal: principal;
   clipId: text;
   editionNumber: nat;
   pricePaid: float64;
   purchaseId: text;
   purchasedAt: int;
   status: PurchaseStatus;
 };
type PricePoint = 
 record {
   editionNumber: nat;
   salePrice: float64;
   timestamp: int;
 };
type PriceHistorySummary = 
 record {
   currentPrice: float64;
   firstSaleTimestamp: opt int;
   lastSaleTimestamp: opt int;
   maxPrice: float64;
   minPrice: float64;
   totalSales: nat;
 };
type PayoutType = 
 variant {
   auctionWin;
   copySale;
   secondaryRoyalty;
 };
type Payout = 
 record {
   btcAmountE8s: nat;
   clipId: text;
   payoutId: text;
   payoutType: PayoutType;
   timestamp: int;
 };
type PackStatus = 
 variant {
   opened;
   sealed;
 };
type PackOpenResult = 
 variant {
   err: text;
   ok: Collectible;
 };
type Pack = 
 record {
   collectibleId: opt text;
   coverImageUrl: text;
   createdAt: int;
   id: text;
   openedAt: opt int;
   ownerPrincipal: principal;
   packCount: nat;
   releaseId: text;
   serialNumber: nat;
   setName: text;
   status: PackStatus;
   totalSupply: nat;
 };
type OfferStatus = 
 variant {
   accepted;
   declined;
   pending;
 };
type Offer = 
 record {
   buyerPrincipal: principal;
   createdAt: int;
   id: nat;
   listingId: nat;
   offerPriceUsd: float64;
   status: OfferStatus;
 };
type MarketListing = 
 record {
   editionId: nat;
   price: nat;
   seller: principal;
 };
type MarketCapEntry = 
 record {
   clipId: text;
   copiesSold: nat;
   creatorName: text;
   currentPriceUsd: float64;
   marketCapUsd: float64;
   previewUrl: text;
   title: text;
   totalSupply: nat;
   videoUrl: text;
 };
type ListingStatus = 
 variant {
   active;
   cancelled;
   sold;
 };
type Listing = 
 record {
   clipId: text;
   editionNumber: nat;
   id: nat;
   listPriceUsd: float64;
   listedAt: int;
   sellerPrincipal: principal;
   status: ListingStatus;
   totalEditions: nat;
 };
type EarningsSummary = 
 record {
   fromAuctionWins: float64;
   fromCopySales: float64;
   fromTradeRoyalties: float64;
   totalBtcE8s: nat;
   totalUsd: float64;
   transactionCount: nat;
 };
type Deposit = 
 record {
   btcAmountE8s: nat;
   confirmationStatus: ConfirmationStatus;
   depositId: text;
   timestamp: int;
   txid: text;
 };
type CreateTcgSetInput = 
 record {
   cardCount: opt nat;
   coverImageUrl: text;
   featured: bool;
   isActive: bool;
   releaseYear: nat;
   setCode: text;
   setName: text;
   slug: text;
   sortOrder: nat;
   tcgCategory: text;
 };
type CreateTcgCategoryInput = 
 record {
   imageUrl: text;
   isActive: bool;
   name: text;
   slug: text;
   sortOrder: nat;
 };
type CreateTcgCardInput = 
 record {
   cardName: text;
   cardNumber: text;
   imageUrl: text;
   isActive: bool;
   isSupported: bool;
   rarity: text;
   setId: nat;
   sortOrder: nat;
 };
type ConfirmationStatus = 
 variant {
   confirmed;
   pending;
 };
type CollectibleMediaType = 
 variant {
   photo;
   video;
 };
type Collectible = 
 record {
   creator: text;
   editionNumber: nat;
   id: text;
   imageUrl: text;
   mediaType: CollectibleMediaType;
   mintDate: text;
   openedAt: int;
   ownerPrincipal: principal;
   packId: text;
   rarity: text;
   releaseId: text;
   setName: text;
   title: text;
   totalSupply: nat;
   typeSupply: nat;
 };
type BondingCurveState = 
 record {
   clipId: text;
   copiesMinted: nat;
   currentPrice: float64;
   nextPrice: float64;
   priceIncrementFactor: float64;
   soldOut: bool;
   startingPrice: float64;
   totalSupply: nat;
 };
type Album = 
 record {
   artist: text;
   collectionName: text;
   coverImageUrl: text;
   id: text;
   title: text;
   totalSupply: nat;
   tracklist: vec Track;
 };
type AddPackInput = 
 record {
   coverImageUrl: text;
   id: text;
   ownerPrincipal: principal;
   packCount: nat;
   releaseId: text;
   serialNumber: nat;
   setName: text;
   totalSupply: nat;
 };
service : {
  acceptOffer: (offerId: nat) -> (variant {
                                    err: text;
                                    ok: bool;
                                  });
  addAlbum: (album: Album) -> ();
  addPack: (input: AddPackInput) -> ();
  addRelease: (release: Release) -> ();
  assignRole: (user: principal, role: UserRole) -> ();
  cancelListing: (listingId: nat) -> (variant {
                                        err: text;
                                        ok: bool;
                                      });
  /// Check for new incoming UTXOs on the caller's BTC deposit address using ICP's Bitcoin API.
  /// Credits balance for UTXOs with height > 0 (at least 1 confirmation).
  /// Tracks seen UTXO outpoints to prevent double-crediting.
  checkForNewDeposits: () -> (variant {
                                err: text;
                                ok: nat;
                              });
  /// Check whether the caller is allowed to like (max 30 likes per minute;
  /// also blocks accounts created within the last 60 seconds).
  /// Returns #ok(true) when allowed, #err with a human-readable message when blocked.
  checkLikeRateLimit: () -> (variant {
                               err: text;
                               ok: bool;
                             });
  /// Check whether the caller is allowed to mint (max 10 mints per 10 minutes).
  /// Returns #ok(true) when allowed, #err with a human-readable message when blocked.
  checkMintRateLimit: () -> (variant {
                               err: text;
                               ok: bool;
                             });
  /// Re-check pending deposits using the ICP Bitcoin API.
  /// Confirms deposits whose UTXO now has >= 1 confirmation and credits balance.
  confirmPendingDeposits: () -> (variant {
                                   err: text;
                                   ok: nat;
                                 });
  createCard: (input: CreateTcgCardInput) -> (TcgCard);
  createCategory: (input: CreateTcgCategoryInput) -> (TcgCategory);
  /// Create a new video clip post. Returns the generated clip_id.
  createClip: (video_file_url: text, preview_loop_url: text, title: opt text,
   hashtags: vec text, explicit_flag: bool) -> (text);
  createListing: (clipId: text, editionNumber: nat, listPriceUsd: float64) ->
   (variant {
      err: text;
      ok: nat;
    });
  createSet: (input: CreateTcgSetInput) -> (TcgSet);
  declineOffer: (offerId: nat) -> (variant {
                                     err: text;
                                     ok: bool;
                                   });
  deleteCard: (id: nat) -> ();
  deleteCategory: (id: nat) -> ();
  deleteSet: (id: nat) -> ();
  getAlbumById: (id: text) -> (opt Album) query;
  getAlbums: () -> (vec Album) query;
  getAllCardsAdmin: () -> (vec TcgCard) query;
  getAllCategoriesAdmin: () -> (vec TcgCategory) query;
  getAllSetsAdmin: () -> (vec TcgSet) query;
  /// Returns merged wallet activity (deposits + payouts + mint costs) newest-first.
  getAllWalletActivity: () -> (vec WalletActivity);
  /// Get the bonding curve state for a single clip.
  getBondingCurveState: (clipId: text) -> (opt BondingCurveState) query;
  /// Batch-fetch bonding curve states for multiple clips (for feed rendering).
  getBondingCurveStates: (clipIds: vec text) -> (vec BondingCurveState) query;
  /// Returns the current USD/BTC rate used for conversions.
  /// Defaults to 50000 if no live rate is set.
  getBtcRate: () -> (float64) query;
  getCallerCollectibles: () -> (vec Collectible) query;
  getCallerPacks: () -> (vec Pack) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCardsBySet: (setId: nat) -> (vec TcgCard) query;
  getCardsBySetAdmin: (setId: nat) -> (vec TcgCard) query;
  getCategories: () -> (vec TcgCategory) query;
  /// Fetch clips sorted by newest, trending (viral score), or top (total likes).
  /// safeView=true hides explicit clips.
  getClips: (sortBy: VideoClipSort, safeView: bool) -> (vec VideoClip) query;
  /// Fetch clips filtered to a specific hashtag.
  /// Delegates to getClipsForHashtag with newest sort and no safe view filter.
  getClipsByHashtag: (hashtag: text) -> (vec VideoClip) query;
  /// Fetch clips filtered to a specific hashtag (case-insensitive), then sorted.
  getClipsForHashtag: (hashtag: text, sortBy: VideoClipSort, safeView:
   bool) -> (vec VideoClip) query;
  /// Get all clips together with their bonding curve state in one call.
  getClipsWithCurveState: () ->
   (vec record {
          VideoClip;
          opt BondingCurveState;
        }) query;
  /// Get all clips created by a specific principal.
  getCreatorClips: (creator: principal) -> (vec VideoClip) query;
  getCurrentPrice: (clipId: text) -> (float64) query;
  getFeaturedSets: () -> (vec TcgSet) query;
  getListings: () -> (vec Listing) query;
  getListingsByClip: (clipId: text) -> (vec Listing) query;
  getMarketCap: (clipId: text) -> (opt MarketCapEntry) query;
  getMarketListings: () -> (vec MarketListing) query;
  /// Returns the caller's in-app BTC balance in e8s (from UserWallet).
  /// Displayed on the frontend as BTC (e8s / 100_000_000).
  getMyBalance: () -> (nat);
  /// Returns an earnings summary for the calling principal.
  /// Sums splits where role == "creator" or role == "seller".
  getMyEarnings: () -> (EarningsSummary) query;
  /// Returns all purchases made by the calling principal.
  getMyPurchases: () -> (vec PurchaseRecord) query;
  getMyRole: () -> (UserRole) query;
  /// Returns transactions where p appears in any split's principal.
  getMyTransactions: (p: principal) -> (vec Transaction) query;
  getOfferHistory: (listingId: nat) -> (vec Offer) query;
  getOffers: (listingId: nat) -> (variant {
                                    err: text;
                                    ok: vec Offer;
                                  }) query;
  /// Returns or creates a UserWallet for the caller.
  getOrCreateUserWallet: () -> (UserWallet);
  /// Returns the caller's BTC deposit address as their payment address.
  /// All payments are in BTC — no internal payment terminology exposed.
  getPaymentAddress: () -> (text);
  getPokemonSets: () -> (vec TcgSet) query;
  getPriceHistory: (clipId: text) -> (vec PricePoint) query;
  /// Returns ALL price points for a clip, sorted chronologically (oldest first).
  /// This is the primary endpoint for rendering complete chart data.
  getPriceHistoryFull: (clipId: text) -> (vec PricePoint) query;
  /// Returns summary statistics for a clip's sales history.
  /// Useful for chart header stats (total sold, price range, latest activity).
  getPriceHistorySummary: (clipId: text) -> (PriceHistorySummary) query;
  getReleases: () -> (vec Release) query;
  getSetById: (id: nat) -> (opt TcgSet) query;
  getSetBySlug: (slug: text) -> (opt TcgSet) query;
  getSets: () -> (vec TcgSet) query;
  getSetsByCategory: (categorySlug: text) -> (vec TcgSet) query;
  getTop10ByMarketCap: () -> (vec MarketCapEntry) query;
  /// Returns all transactions newest-first.
  getTransactionHistory: () -> (vec Transaction) query;
  /// Get trending hashtags sorted by like score descending.
  /// Returns (tag, post_count) pairs.
  getTrendingHashtags: () -> (vec record {
                                    text;
                                    nat;
                                  }) query;
  /// Get trending hashtags with a hot flag.
  /// Returns (tag, post_count, is_hot) — is_hot is true for tags in the top 3 by like score.
  getTrendingHashtagsWithHotFlag: () -> (vec record {
                                               text;
                                               nat;
                                               bool;
                                             }) query;
  getUserCollectibles: (user: principal) -> (vec Collectible) query;
  /// Returns the caller's unique BTC deposit address (real on-chain address via ICP Bitcoin API).
  /// Derives the address on first call and caches it in the wallet.
  getUserDepositAddress: () -> (text);
  /// Returns all deposits (pending and confirmed) for the caller.
  getUserDeposits: () -> (vec Deposit);
  getUserPacks: (user: principal) -> (vec Pack) query;
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  /// Retrieve raw video/preview blob data by asset_id.
  getVideoBlob: (asset_id: text) -> (opt VideoAsset) query;
  /// Initialize bonding curve state for a newly created clip.
  /// Only callable by the clip's creator.
  initBondingCurve: (clipId: text) ->
   (variant {
      err: text;
      ok: BondingCurveState;
    });
  isAdmin: () -> (bool) query;
  /// Like a clip. Returns new like_count on success.
  /// Returns #err with a message on rate-limit, duplicate like, or account-too-new.
  likeClip: (clip_id: text) -> (variant {
                                  err: text;
                                  ok: nat;
                                });
  makeOffer: (listingId: nat, offerPriceUsd: float64) ->
   (variant {
      err: text;
      ok: nat;
    });
  openPack: (packId: text) -> (PackOpenResult);
  /// Process a $1 mint fee deducted from creator's in-app balance → platform.
  /// Returns the internal transaction ID.
  processClipMint: (creatorPrincipal: principal) -> (nat);
  /// Process a bonding curve copy sale via in-app balance.
  /// 95% to creator, 5% to platform — deducted from buyer's balance.
  processCopySale: (clipId: text, creatorPrincipal: principal,
   buyerPrincipal: principal, usdAmount: float64) -> (nat);
  /// Process a secondary trade via in-app balance.
  /// 4% to original creator, 1% to platform, 95% to seller — deducted from buyer's balance.
  processSecondaryTrade: (clipId: text, originalCreatorPrincipal: principal,
   sellerPrincipal: principal, buyerPrincipal: principal, usdAmount:
   float64) -> (nat);
  /// Process a copy sale deducting buyer's wallet balance and crediting creator.
  processWalletCopySale: (clipId: text, creatorPrincipal: principal,
   usdAmount: float64) -> (variant {
                             err: text;
                             ok: nat;
                           });
  /// Process a $1 mint fee deducting from user's in-app wallet balance.
  /// Returns #err("insufficient balance") if user cannot afford it.
  processWalletMint: (clipId: text) -> (variant {
                                          err: text;
                                          ok: nat;
                                        });
  /// Process a secondary trade deducting buyer and crediting seller + creator.
  processWalletSecondaryTrade: (clipId: text, originalCreatorPrincipal:
   principal, sellerPrincipal: principal, usdAmount: float64) ->
   (variant {
      err: text;
      ok: nat;
    });
  /// Buy a copy of a clip. Assigns an edition number, stores the purchase as #pending,
  /// and promotes all purchases to #minted when all 1000 copies are sold.
  recordPurchase: (clipId: text, pricePaid: float64) ->
   (variant {
      err: text;
      ok: PurchaseRecord;
    });
  /// Record a video hash for the caller. Returns #err("duplicate") if the hash
  /// was already submitted by any user, otherwise records it and returns #ok(true).
  recordVideoHash: (hash: text) -> (variant {
                                      err: text;
                                      ok: bool;
                                    });
  saveCallerUserProfile: (profile: UserProfile) -> ();
  searchSetsByName: (searchTerm: text) -> (vec TcgSet) query;
  /// Admin: update the BTC/USD rate used for e8s conversions.
  setBtcRate: (rate: float64) -> ();
  toggleCardActive: (id: nat) -> ();
  toggleCardSupported: (id: nat) -> ();
  toggleCategoryActive: (id: nat) -> ();
  toggleSetActive: (id: nat) -> ();
  updateCard: (input: UpdateTcgCardInput) -> (TcgCard);
  updateCategory: (input: UpdateTcgCategoryInput) -> (TcgCategory);
  updateSet: (input: UpdateTcgSetInput) -> (TcgSet);
  /// Upload a raw preview clip blob (short 2s muted mp4). Returns asset_id to use as preview_loop_url.
  uploadPreviewBlob: (data: blob, content_type: text) -> (text);
  /// Upload a raw HD video blob (mp4). Returns asset_id to use as video_file_url.
  uploadVideoBlob: (data: blob, content_type: text) -> (text);
}
